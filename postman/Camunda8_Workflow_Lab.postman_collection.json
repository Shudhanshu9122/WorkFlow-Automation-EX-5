      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"studentName\": \"Sudhanshu Kumar\",\n  \"regNo\": \"RA2311003010001\",\n  \"hostelBlock\": \"M-Block, Room 412\",\n  \"outDate\": \"2026-10-25\",\n  \"returnDate\": \"2026-10-25\",\n  \"parentPhone\": \"+919876543210\",\n  \"purpose\": \"Local market visit & stationery purchase\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/outpass",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["outpass"]
        },
        "description": "Submits a same-day outpass request (nights = 0) which is auto-approved by the gateway without warden intervention."
      }
    },
    {
